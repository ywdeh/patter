{
  "id": "/",
  "name": "Patter",
  "short_name": "Patter",
  "description": "An ambient text editor for you to focus on writing. Change the workplace however you want, and finish that chapter. Once more.",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b120f",
  "theme_color": "#0b120f",
  "categories": ["productivity", "writing"],
  "related_applications": [
    { "platform": "webapp", "url": "/manifest.webmanifest", "id": "/" }
  ],
  "protocol_handlers": [
    { "protocol": "web+patter", "url": "/?launch=%s" }
  ],
  "icons": [
    {
      "src": "/icons/patter_192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/patter_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/patter_maskable_512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
